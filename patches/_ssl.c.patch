+const int UNEXPECTED_BIO_READ_ERROR = -1;
+const int UNEXPECTED_BIO_WRITE_ERROR = -2;
+const int UNEXPECTED_BIO_MEMORY_LEAK = -3;
+const int UNEXPECTED_BIO_RESET_ERROR = -4;
